{
  "name": "@hellaweb3/foundryanvil-testcontainers-nodejs",
  "description": "Fluent, type-safe Testcontainers module for Foundry Anvil: every anvil CLI flag with conflict/dependency validation, reliable startup, host/container state transfer and a chain-aware viem test client with helpers.",
  "homepage": "https://hellalabs.dev/foundryanvil-testcontainers-nodejs/",
  "repository": "https://github.com/hella-labs/foundryanvil-testcontainers-nodejs",
  "bugs": "https://github.com/hella-labs/foundryanvil-testcontainers-nodejs/issues",
  "keywords": [
    "testcontainers",
    "foundry",
    "anvil",
    "ethereum",
    "viem",
    "evm",
    "blockchain",
    "typescript",
    "nodejs",
    "docker",
    "testing",
    "integration-testing",
    "e2e-testing"
  ],
  "version": "0.7.0",
  "license": "MIT",
  "author": "Chris Anatalio",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdx dev",
    "build": "tsdx build && node scripts/compact-dist.mjs",
    "test": "jest --colors --injectGlobals",
    "test:unit": "jest --colors --injectGlobals test/unit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:coverage": "jest --colors --injectGlobals --coverage test/unit",
    "bench": "node scripts/bench.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lockfiles:check": "node scripts/lockfiles.mjs check",
    "lockfiles:restore": "node scripts/lockfiles.mjs restore",
    "examples:setup": "node scripts/examples.mjs setup",
    "examples:unit": "node scripts/examples.mjs unit",
    "examples:e2e": "node scripts/examples.mjs e2e",
    "docs:setup": "node scripts/docs.mjs setup",
    "docs:sync": "node scripts/docs.mjs sync",
    "docs:check": "node scripts/docs.mjs check",
    "docs:start": "node scripts/docs.mjs start",
    "docs:build": "node scripts/docs.mjs build",
    "docs:serve": "node scripts/docs.mjs serve",
    "docs:typecheck": "node scripts/docs.mjs typecheck",
    "docs:lint": "node scripts/docs.mjs lint",
    "docs:unit": "node scripts/docs.mjs unit",
    "docs:e2e": "node scripts/docs.mjs e2e",
    "setup:all": "pnpm install && pnpm examples:setup && pnpm docs:setup",
    "gate": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit --coverage && pnpm test:e2e --no-docker && pnpm examples:e2e --no-docker && pnpm examples:unit --coverage && pnpm docs:unit --coverage && pnpm docs:e2e --no-docker --skip-examples",
    "check:local": "pnpm gate",
    "check:docker": "pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit --coverage && pnpm test:e2e && pnpm examples:e2e && pnpm examples:unit --coverage && pnpm docs:unit --coverage && pnpm docs:e2e --skip-examples"
  },
  "dependencies": {
    "testcontainers": "^12.2.2",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundry-rs/anvil": "1.6.0-rc1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "bunchee": "^7.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "tsdx": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "moduleFileExtensions": [
      "js",
      "cjs",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": {
              "syntax": "typescript"
            }
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/examples/",
      "<rootDir>/docs/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/examples/",
      "<rootDir>/docs/"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5"
}
